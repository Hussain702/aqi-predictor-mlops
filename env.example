# Fill these in with your own keys before running extract.py
# Get AQICN token (free, instant): https://aqicn.org/data-platform/token/
# Get OpenWeather key (free, instant): https://openweathermap.org/api

AQICN_API_TOKEN=your_aqicn_token_here
OPENWEATHER_API_KEY=your_openweather_key_here
CITY=lahore

# Get these after creating your Hopsworks account + project (see chat for steps)
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT_NAME=your_hopsworks_project_name_here
